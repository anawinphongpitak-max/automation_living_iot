MQTT_BROKER=mqtts://your-hivemq-host.hivemq.cloud:8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
PORT=3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=smart_home_iot

# Telegram Security Alert Configuration
# Alerts are only sent when BOTH values are set
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Web Dashboard Login Session Configuration
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=your-session-secret-here
