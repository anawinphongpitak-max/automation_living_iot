}

body.light-mode .fp-table {
    border: 1px solid #d0d7d5;
}

body.light-mode .fp-table-header {
    background: #f5f7f6;
    border-bottom: 2px solid #d0d7d5;
    color: #1a2421;
}

body.light-mode .fp-table-row {
    background: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    color: #1a2421;
}

body.light-mode .fp-table-row:hover {
    background: #f9f9f9;
}

body.light-mode .fp-protected-badge {
    background: #fff3cd;
    color: #856404;
    border: 1px solid #ffeeba;
}

body.light-mode .fp-table-loading,
body.light-mode .fp-table-empty {
